{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public non-PII directory profile for Gram Panchayat portal members.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "ward": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "roleLabel": {
          "type": "string",
          "enum": [
            "Public Citizen",
            "Authorized Officer",
            "Administrative Staff"
          ]
        },
        "isDirectoryVisible": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "ward",
        "roleLabel",
        "isDirectoryVisible",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivateContact": {
      "title": "UserPrivateContact",
      "description": "Isolated private PII contact information accessible strictly to the owner or administrative staff.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "maxLength": 20
        },
        "address": {
          "type": "string",
          "maxLength": 200
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "phone",
        "address",
        "updatedAt"
      ]
    },
    "RoleGrant": {
      "title": "RoleGrant",
      "description": "Authoritative RBAC grant record stored in admins or authorizedStaff collections.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "enum": [
            "admin",
            "authorized"
          ]
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "designation": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "role",
        "grantedBy",
        "designation",
        "createdAt"
      ]
    },
    "ServiceRequest": {
      "title": "ServiceRequest",
      "description": "Villager-reported local infrastructure or civic service request with photo evidence.",
      "type": "object",
      "properties": {
        "trackingCode": {
          "type": "string",
          "minLength": 4,
          "maxLength": 24,
          "pattern": "^[A-Z0-9\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1000
        },
        "category": {
          "type": "string",
          "enum": [
            "Water Supply",
            "Roads & Drainage",
            "Street Lighting",
            "Sanitation",
            "Electricity",
            "Public Health"
          ]
        },
        "ward": {
          "type": "string",
          "minLength": 2,
          "maxLength": 40
        },
        "landmark": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120
        },
        "status": {
          "type": "string",
          "enum": [
            "Submitted",
            "Verified",
            "In Progress",
            "Resolved",
            "Closed"
          ]
        },
        "priority": {
          "type": "string",
          "enum": [
            "Low",
            "Medium",
            "High",
            "Urgent"
          ]
        },
        "photoUrl": {
          "type": "string",
          "maxLength": 100000
        },
        "resolutionPhotoUrl": {
          "type": "string",
          "maxLength": 100000
        },
        "reporterUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "reporterName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "assignedOfficerUid": {
          "type": "string",
          "maxLength": 128
        },
        "assignedOfficerName": {
          "type": "string",
          "maxLength": 80
        },
        "officerNotes": {
          "type": "string",
          "maxLength": 600
        },
        "estimatedBudget": {
          "type": "number"
        },
        "monthKey": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public"
          ]
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "trackingCode",
        "title",
        "description",
        "category",
        "ward",
        "landmark",
        "status",
        "priority",
        "photoUrl",
        "resolutionPhotoUrl",
        "reporterUid",
        "reporterName",
        "assignedOfficerUid",
        "assignedOfficerName",
        "officerNotes",
        "estimatedBudget",
        "monthKey",
        "visibility",
        "createdAt",
        "updatedAt"
      ]
    },
    "ServiceUpdate": {
      "title": "ServiceUpdate",
      "description": "Audit log entry recording field verification or status progression on a service request.",
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "authorRole": {
          "type": "string",
          "enum": [
            "Public Citizen",
            "Authorized Officer",
            "Administrative Staff"
          ]
        },
        "previousStatus": {
          "type": "string",
          "enum": [
            "Submitted",
            "Verified",
            "In Progress",
            "Resolved",
            "Closed"
          ]
        },
        "newStatus": {
          "type": "string",
          "enum": [
            "Submitted",
            "Verified",
            "In Progress",
            "Resolved",
            "Closed"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "requestId",
        "authorUid",
        "authorName",
        "authorRole",
        "previousStatus",
        "newStatus",
        "note",
        "visibility",
        "createdAt"
      ]
    },
    "MonthlyReport": {
      "title": "MonthlyReport",
      "description": "Official monthly Gram Panchayat transparency and service performance report.",
      "type": "object",
      "properties": {
        "monthKey": {
          "type": "string",
          "minLength": 7,
          "maxLength": 7,
          "pattern": "^[0-9]{4}-[0-9]{2}$"
        },
        "monthLabel": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40
        },
        "totalRequests": {
          "type": "number"
        },
        "resolvedCount": {
          "type": "number"
        },
        "inProgressCount": {
          "type": "number"
        },
        "verifiedCount": {
          "type": "number"
        },
        "pendingCount": {
          "type": "number"
        },
        "resolutionRate": {
          "type": "number"
        },
        "totalSanctionedBudget": {
          "type": "number"
        },
        "topCategory": {
          "type": "string",
          "maxLength": 60
        },
        "summaryText": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1500
        },
        "actionPlan": {
          "type": "string",
          "maxLength": 1000
        },
        "publishedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "publishedByName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "isPublished": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "monthKey",
        "monthLabel",
        "totalRequests",
        "resolvedCount",
        "inProgressCount",
        "verifiedCount",
        "pendingCount",
        "resolutionRate",
        "totalSanctionedBudget",
        "topCategory",
        "summaryText",
        "actionPlan",
        "publishedByUid",
        "publishedByName",
        "isPublished",
        "createdAt",
        "updatedAt"
      ]
    },
    "Notification": {
      "title": "Notification",
      "description": "Real-time progress update or village-wide civic announcement.",
      "type": "object",
      "properties": {
        "recipientUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "requestId": {
          "type": "string",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "message": {
          "type": "string",
          "minLength": 5,
          "maxLength": 400
        },
        "type": {
          "type": "string",
          "enum": [
            "status_update",
            "assignment",
            "report_published",
            "public_notice"
          ]
        },
        "isRead": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "recipientUid",
        "senderUid",
        "requestId",
        "title",
        "message",
        "type",
        "isRead",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Public directory profiles without PII."
    },
    "/users/{userId}/private/{docId}": {
      "schema": {
        "$ref": "#/entities/UserPrivateContact"
      },
      "description": "Owner- and admin-only private contact details (email, phone, address)."
    },
    "/admins/{adminUid}": {
      "schema": {
        "$ref": "#/entities/RoleGrant"
      },
      "description": "Administrative staff role grants managed strictly by existing admins."
    },
    "/authorizedStaff/{staffUid}": {
      "schema": {
        "$ref": "#/entities/RoleGrant"
      },
      "description": "Authorized ward officer role grants managed strictly by admins."
    },
    "/serviceRequests/{requestId}": {
      "schema": {
        "$ref": "#/entities/ServiceRequest"
      },
      "description": "Civic issues and service requests submitted by villagers with photo evidence."
    },
    "/serviceRequests/{requestId}/updates/{updateId}": {
      "schema": {
        "$ref": "#/entities/ServiceUpdate"
      },
      "description": "Chronological status progression and inspection notes for each service request."
    },
    "/monthlyReports/{reportId}": {
      "schema": {
        "$ref": "#/entities/MonthlyReport"
      },
      "description": "Published monthly status and transparency reports."
    },
    "/notifications/{notificationId}": {
      "schema": {
        "$ref": "#/entities/Notification"
      },
      "description": "Real-time notifications for citizens and village-wide announcements."
    }
  }
}
